{
    "name":  "a008-electron-client",
    "version":  "0.0.0",
    "private":  true,
    "description":  "Windows x64 Electron shell for the A008 local GUI host",
    "license":  "Apache-2.0",
    "type":  "module",
    "main":  ".vite/build/main.js",
    "scripts":  {
                    "start":  "electron-forge start",
                    "test":  "node --experimental-strip-types --test \"src/**/*.test.ts\"",
                    "typecheck":  "tsc --noEmit --allowImportingTsExtensions",
                    "package:win32:x64":  "npm run desktop:prepare --prefix ../.. \u0026\u0026 electron-forge package --platform=win32 --arch=x64"
                },
    "config":  {
                   "forge":  "./forge.config.ts"
               },
    "dependencies":  {
                         "electron-squirrel-startup":  "^1.0.1"
                     },
    "devDependencies":  {
                            "@electron-forge/cli":  "^7.8.3",
                            "@electron-forge/plugin-vite":  "^7.8.3",
                            "@electron-forge/plugin-fuses":  "^7.8.3",
                            "@electron/fuses":  "^1.8.0",
                            "@types/node":  "^24.0.0",
                            "electron":  "^36.9.5",
                            "typescript":  "^5.9.3",
                            "vite":  "^6.4.1"
                        }
}
