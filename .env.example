# Copy to .env.local for local CLI use. Never commit real credentials.

# Optional Stage-3.5 ACME model-only execution. Direct NVIDIA/kie/OpenAI
# transports remain the default. Set A008_CHAT_TRANSPORT=acme to select the
# adapter; it talks only to acme-model-runtime/1 and never to /v1/execute.
# Provider credentials belong to the ACME runtime composition, not A008.
A008_CHAT_TRANSPORT=direct
A008_ACME_MODEL_RUNTIME_URL=
A008_ACME_MODEL_RUNTIME_TOKEN=
A008_ACME_ENGINE_BUILD=

A008_GUI_HOST_BIND=0.0.0.0
A008_GUI_HOST_PORT=8787

# Optional full chat-completions endpoint override for a trusted local proxy or
# fake integration server. The official NVIDIA endpoint is used when omitted.
#NVIDIA_CHAT_COMPLETIONS_URL=

# Optional stable A008 runtime IDs. Canonical form: A008_v1_<kind>_<uuidv4>.
#A008_PROJECT_ID=
#A008_AGENT_ID=

# SQLite path outside the repository. Defaults to ~/.A008/memory.sqlite.
#A008_MEMORY_SQLITE_PATH=

# Debug trace: off (default), safe, or raw. Raw writes local prompts and answers.
A008_DEBUG_TRACE=off

# Absolute JSONL path. Required for raw mode and for any ACP tracing.
#A008_DEBUG_TRACE_FILE=

# Global editable runtime budgets/instructions, outside all projects.
#A008_SETTINGS_PATH=

# Engine mode selects a separate store for each canonical workspace.
#A008_ENGINE_DATA_PATH=

# Optional deliberate attachment of an existing store to one workspace.
# Requires A008_MEMORY_SQLITE_PATH and A008_SOURCE_STORE_PATH together.
#A008_ENGINE_LEGACY_CWD=
#A008_SOURCE_STORE_PATH=

# Optional absolute cwd for standalone GUI file, Git and shell tools.
# Does not change the configured standalone memory/source-store paths.
#A008_GUI_WORKSPACE=

# Optional standalone browser gate. Exactly six digits; keep the real PIN local.
A008_GUI_PIN=123456

ACME_MODEL_RUNTIME_LISTEN_HOST="127.0.0.1"
ACME_MODEL_RUNTIME_LISTEN_PORT="8790"
ACME_MODEL_RUNTIME_BEARER_TOKEN="126a5e8c8b9068dcc2225b6ff1fceb15017fe8bad54e8caaf3dd3407b9f30b6f"
ACME_MODEL_RUNTIME_ENGINE_BUILD="acme-npm-0.0.1"

NVIDIA_API_KEY=

ACME_MODEL_RUNTIME_NVIDIA_PROFILES='[
  {
    "selection": {
      "profile": "nvidia/nemotron-3.5-lightning-30b-a3b",
      "providerHint": "nvidia",
      "modelHint": "nvidia/nemotron-3.5-lightning-30b-a3b"
    },
    "model": "nvidia/nemotron-3.5-lightning-30b-a3b"
  }
]'

# Optional OpenAI key. Enables the built-in gpt-5.6-luna profile.

#OPENAI_API_KEY=

#ACME_MODEL_RUNTIME_OPENAI_PROFILES='[
#  {
#    "selection": {
#      "profile": "gpt-5.6-luna",
#      "providerHint": "openai",
#      "modelHint": "gpt-5.6-luna"
#    },
#    "model": "gpt-5.6-luna"
#  }
#]'

# Optional kie.ai aggregator key (https://docs.kie.ai/). Chat uses
# OpenAI-compatible completions; images use async Market jobs.
#KIE_API_KEY=
