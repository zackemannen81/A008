{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "error"
    },
    "serverInstanceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "code": {
      "type": "string",
      "enum": [
        "INVALID_REQUEST",
        "UNAUTHENTICATED",
        "FORBIDDEN",
        "PROJECT_NOT_FOUND",
        "SESSION_EXPIRED",
        "SESSION_BUSY",
        "REVISION_CONFLICT",
        "UNSUPPORTED_CAPABILITY",
        "PROJECT_BINDING_CONFLICT",
        "COMMAND_CONFLICT",
        "COMMAND_UNKNOWN",
        "CAPACITY_EXCEEDED",
        "SNAPSHOT_TOO_LARGE",
        "RUNTIME_FAILED"
      ]
    },
    "message": {
      "type": "string"
    },
    "retryable": {
      "type": "boolean"
    },
    "projectId": {
      "type": "string",
      "pattern": "^A008_v1_project_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  },
  "required": ["type", "serverInstanceId", "code", "message", "retryable"],
  "additionalProperties": false
}
