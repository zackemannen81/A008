{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "signal"
        },
        "signal": {
          "type": "string",
          "enum": ["thought", "answer"]
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "text": {
          "type": "string"
        }
      },
      "required": ["type", "signal", "sessionId", "text"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "signal"
        },
        "signal": {
          "type": "string",
          "const": "tool"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "signal",
        "sessionId",
        "id",
        "title",
        "status",
        "text"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "signal"
        },
        "signal": {
          "type": "string",
          "const": "tool/permission"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "permissionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "signal",
        "sessionId",
        "permissionId",
        "title",
        "text"
      ],
      "additionalProperties": false
    }
  ]
}
