{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "events": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "changes": {
            "type": "object",
            "properties": {
              "answer": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "append": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "append"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "replace": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "replace"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "tools": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "title",
                    "status",
                    "text"
                  ]
                }
              },
              "permission": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string"
                      },
                      "text": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "id",
                      "title",
                      "text"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "cursor",
          "changes"
        ],
        "additionalProperties": false
      }
    },
    "nextCursor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "hasMore": {
      "type": "boolean"
    }
  },
  "required": [
    "events",
    "nextCursor",
    "hasMore"
  ],
  "additionalProperties": false
}
