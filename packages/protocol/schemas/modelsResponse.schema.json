{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema0"
          },
          "name": {
            "$ref": "#/$defs/__schema0"
          },
          "provider": {
            "$ref": "#/$defs/__schema1"
          },
          "executionProvider": {
            "$ref": "#/$defs/__schema1"
          },
          "inputModalities": {
            "readOnly": true,
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema2"
            }
          },
          "verifiedOn": {
            "$ref": "#/$defs/__schema1"
          },
          "defaults": {
            "type": "object",
            "properties": {
              "stream": {
                "type": "boolean"
              },
              "temperature": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/__schema3"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "topP": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/__schema3"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "maxTokens": {
                "$ref": "#/$defs/__schema3"
              },
              "enableThinking": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "reasoningBudget": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/__schema3"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reasoningEffort": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/__schema0"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "seed": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/__schema3"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "stop": {
                "anyOf": [
                  {
                    "readOnly": true,
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/__schema0"
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "stream",
              "temperature",
              "topP",
              "maxTokens",
              "enableThinking",
              "reasoningBudget",
              "reasoningEffort",
              "seed",
              "stop"
            ]
          },
          "capabilities": {
            "type": "object",
            "properties": {
              "maxTokens": {
                "$ref": "#/$defs/__schema3"
              },
              "topP": {
                "type": "boolean"
              },
              "thinking": {
                "type": "boolean"
              },
              "reasoningBudget": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/__schema3"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reasoningEfforts": {
                "readOnly": true,
                "type": "array",
                "items": {
                  "$ref": "#/$defs/__schema0"
                }
              },
              "seed": {
                "type": "boolean"
              },
              "stop": {
                "type": "boolean"
              },
              "verifiedOn": {
                "$ref": "#/$defs/__schema0"
              }
            },
            "required": [
              "maxTokens",
              "topP",
              "thinking",
              "reasoningBudget",
              "reasoningEfforts",
              "seed",
              "stop",
              "verifiedOn"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "provider",
          "executionProvider",
          "inputModalities",
          "defaults",
          "capabilities"
        ]
      }
    }
  },
  "required": [
    "models"
  ],
  "$defs": {
    "__schema0": {
      "type": "string"
    },
    "__schema1": {
      "minLength": 1,
      "$ref": "#/$defs/__schema0"
    },
    "__schema2": {
      "type": "string",
      "enum": [
        "text",
        "image",
        "video",
        "audio"
      ]
    },
    "__schema3": {
      "type": "number"
    }
  }
}
