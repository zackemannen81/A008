{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "projectId": {
      "type": "string",
      "pattern": "^A008_v1_project_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "model": {
      "type": "string"
    },
    "parameters": {
      "type": "object",
      "properties": {
        "stream": {
          "type": "boolean"
        },
        "temperature": {
          "type": [
            "number",
            "null"
          ]
        },
        "topP": {
          "type": [
            "number",
            "null"
          ]
        },
        "maxTokens": {
          "type": "number"
        },
        "enableThinking": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reasoningBudget": {
          "type": [
            "number",
            "null"
          ]
        },
        "reasoningEffort": {
          "type": [
            "string",
            "null"
          ]
        },
        "seed": {
          "type": [
            "number",
            "null"
          ]
        },
        "stop": {
          "anyOf": [
            {
              "readOnly": true,
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "stream",
        "temperature",
        "topP",
        "maxTokens",
        "enableThinking",
        "reasoningBudget",
        "reasoningEffort",
        "seed",
        "stop"
      ],
      "additionalProperties": false
    },
    "messages": {
      "readOnly": true,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ]
          },
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "readOnly": true,
                "minItems": 1,
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "text"
                        },
                        "text": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "type",
                        "text"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "generated_image"
                        },
                        "generationId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "prompt": {
                          "type": "string",
                          "minLength": 1
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "pending",
                            "completed",
                            "failed",
                            "cancelled"
                          ]
                        },
                        "locator": {
                          "type": "string",
                          "minLength": 1
                        },
                        "mediaType": {
                          "type": "string",
                          "minLength": 1
                        },
                        "filename": {
                          "type": "string",
                          "minLength": 1
                        },
                        "error": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "type",
                        "generationId",
                        "prompt",
                        "status"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            ]
          }
        },
        "required": [
          "messageId",
          "role",
          "content"
        ],
        "additionalProperties": false
      }
    },
    "active": {
      "type": "boolean"
    },
    "activeTurn": {
      "type": "object",
      "properties": {
        "turnId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "status": {
          "type": "string",
          "const": "running"
        }
      },
      "required": [
        "turnId",
        "status"
      ],
      "additionalProperties": false
    },
    "tools": {
      "readOnly": true,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "undone": {
      "type": "boolean"
    },
    "closed": {
      "type": "boolean"
    }
  },
  "required": [
    "projectId",
    "sessionId",
    "sequence",
    "model",
    "parameters",
    "messages",
    "active"
  ],
  "additionalProperties": false
}
