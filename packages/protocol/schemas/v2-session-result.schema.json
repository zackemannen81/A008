{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "result"
    },
    "serverInstanceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "commandId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "action": {
      "type": "string",
      "enum": [
        "session/new",
        "session/resume",
        "session/inspect",
        "session/prompt",
        "session/cancel",
        "session/control",
        "tool/permission"
      ]
    },
    "projectId": {
      "type": "string",
      "pattern": "^A008_v1_project_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "state": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "pattern": "^A008_v1_project_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "model": {
          "type": "string"
        },
        "parameters": {
          "type": "object",
          "properties": {
            "stream": {
              "type": "boolean"
            },
            "temperature": {
              "type": [
                "number",
                "null"
              ]
            },
            "topP": {
              "type": [
                "number",
                "null"
              ]
            },
            "maxTokens": {
              "type": "number"
            },
            "enableThinking": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "reasoningBudget": {
              "type": [
                "number",
                "null"
              ]
            },
            "reasoningEffort": {
              "type": [
                "string",
                "null"
              ]
            },
            "seed": {
              "type": [
                "number",
                "null"
              ]
            },
            "stop": {
              "anyOf": [
                {
                  "readOnly": true,
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "stream",
            "temperature",
            "topP",
            "maxTokens",
            "enableThinking",
            "reasoningBudget",
            "reasoningEffort",
            "seed",
            "stop"
          ],
          "additionalProperties": false
        },
        "messages": {
          "readOnly": true,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "messageId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "role": {
                "type": "string",
                "enum": [
                  "user",
                  "assistant"
                ]
              },
              "content": {
                "type": "string"
              }
            },
            "required": [
              "messageId",
              "role",
              "content"
            ],
            "additionalProperties": false
          }
        },
        "active": {
          "type": "boolean"
        },
        "activeTurn": {
          "type": "object",
          "properties": {
            "turnId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "status": {
              "type": "string",
              "const": "running"
            }
          },
          "required": [
            "turnId",
            "status"
          ],
          "additionalProperties": false
        },
        "tools": {
          "readOnly": true,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "description"
            ],
            "additionalProperties": false
          }
        },
        "undone": {
          "type": "boolean"
        },
        "closed": {
          "type": "boolean"
        }
      },
      "required": [
        "projectId",
        "sessionId",
        "sequence",
        "model",
        "parameters",
        "messages",
        "active"
      ],
      "additionalProperties": false
    },
    "resumeCapability": {
      "type": "string",
      "minLength": 32,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "receipt": {
      "type": "object",
      "properties": {
        "serverInstanceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "commandId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "projectId": {
          "type": "string",
          "pattern": "^A008_v1_project_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "turnId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "status": {
          "type": "string",
          "enum": [
            "running",
            "succeeded",
            "failed"
          ]
        },
        "startedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "settledAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "INVALID_REQUEST",
                "UNAUTHENTICATED",
                "FORBIDDEN",
                "PROJECT_NOT_FOUND",
                "SESSION_EXPIRED",
                "SESSION_BUSY",
                "REVISION_CONFLICT",
                "UNSUPPORTED_CAPABILITY",
                "PROJECT_BINDING_CONFLICT",
                "COMMAND_CONFLICT",
                "COMMAND_UNKNOWN",
                "CAPACITY_EXCEEDED",
                "SNAPSHOT_TOO_LARGE",
                "RUNTIME_FAILED"
              ]
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "serverInstanceId",
        "commandId",
        "action",
        "projectId",
        "status",
        "startedAt"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "serverInstanceId",
    "requestId",
    "action",
    "projectId"
  ],
  "additionalProperties": false
}
