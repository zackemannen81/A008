{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "command"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "projectId": {
          "type": "string",
          "pattern": "^A008_v1_project_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "action": {
          "type": "string",
          "const": "session/new"
        },
        "payload": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["type", "requestId", "projectId", "action"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "command"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "projectId": {
          "type": "string",
          "pattern": "^A008_v1_project_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "action": {
          "type": "string",
          "const": "session/inspect"
        }
      },
      "required": ["type", "requestId", "projectId", "sessionId", "action"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "command"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "projectId": {
          "type": "string",
          "pattern": "^A008_v1_project_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "action": {
          "type": "string",
          "const": "session/prompt"
        },
        "payload": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["text"],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "requestId",
        "projectId",
        "sessionId",
        "action",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "command"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "projectId": {
          "type": "string",
          "pattern": "^A008_v1_project_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "action": {
          "type": "string",
          "const": "session/cancel"
        }
      },
      "required": ["type", "requestId", "projectId", "sessionId", "action"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "command"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "projectId": {
          "type": "string",
          "pattern": "^A008_v1_project_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "action": {
          "type": "string",
          "const": "session/control"
        },
        "payload": {
          "type": "object",
          "properties": {
            "control": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "action": {
                      "type": "string",
                      "enum": ["inspect", "reset", "undo", "close"]
                    }
                  },
                  "required": ["action"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "action": {
                      "type": "string",
                      "const": "model"
                    },
                    "model": {
                      "type": "string",
                      "pattern": "\\S"
                    }
                  },
                  "required": ["action", "model"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "action": {
                      "type": "string",
                      "const": "configure"
                    },
                    "parameters": {}
                  },
                  "required": ["action", "parameters"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "action": {
                      "type": "string",
                      "const": "configureRuntime"
                    },
                    "settings": {},
                    "revision": {
                      "type": "string"
                    }
                  },
                  "required": ["action", "settings", "revision"],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": ["control"],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "requestId",
        "projectId",
        "sessionId",
        "action",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "command"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "projectId": {
          "type": "string",
          "pattern": "^A008_v1_project_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "action": {
          "type": "string",
          "const": "tool/permission"
        },
        "payload": {
          "type": "object",
          "properties": {
            "permissionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "allow": {
              "type": "boolean"
            }
          },
          "required": ["permissionId", "allow"],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "requestId",
        "projectId",
        "sessionId",
        "action",
        "payload"
      ],
      "additionalProperties": false
    }
  ]
}
