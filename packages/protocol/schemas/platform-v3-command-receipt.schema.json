{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "commandId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "tenantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "principalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "operation": {
      "type": "string",
      "const": "run.create"
    },
    "payloadDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "createdAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "commandId",
    "tenantId",
    "principalId",
    "operation",
    "payloadDigest",
    "runId",
    "createdAt"
  ],
  "additionalProperties": false
}
