{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "tenantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "projectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "conversationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "principalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "commandId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "cancel_requested",
        "needs_reconciliation",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "createdAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "updatedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "leaseGeneration": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "effectStatus": {
      "type": "string",
      "enum": [
        "none",
        "unknown",
        "known"
      ]
    },
    "answerStatus": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed",
        "unknown"
      ]
    },
    "memoryStatus": {
      "type": "string",
      "enum": [
        "not_requested",
        "pending",
        "completed",
        "failed",
        "unknown"
      ]
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "UNAUTHENTICATED",
            "FORBIDDEN",
            "NOT_FOUND",
            "INVALID_REQUEST",
            "REVISION_CONFLICT",
            "CONVERSATION_BUSY",
            "COMMAND_CONFLICT",
            "CAPACITY_EXCEEDED",
            "LEASE_LOST",
            "NEEDS_RECONCILIATION",
            "INTERNAL_ERROR"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "tenantId",
    "projectId",
    "conversationId",
    "principalId",
    "commandId",
    "model",
    "status",
    "revision",
    "createdAt",
    "updatedAt",
    "leaseGeneration",
    "effectStatus",
    "answerStatus",
    "memoryStatus"
  ],
  "additionalProperties": false
}
