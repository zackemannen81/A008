{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "commandId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "attachment": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "image"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "locator",
        "mediaType"
      ]
    }
  },
  "required": [
    "commandId",
    "expectedRevision",
    "model",
    "text"
  ],
  "additionalProperties": false
}
