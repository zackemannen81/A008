{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "process": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "sessionId": {
              "type": "string"
            },
            "workspaceId": {
              "type": "string"
            },
            "instanceId": {
              "type": "string"
            },
            "processId": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "state": {
              "type": "string",
              "enum": [
                "running",
                "stopped"
              ]
            }
          },
          "required": [
            "sessionId",
            "workspaceId",
            "instanceId",
            "processId",
            "state"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "process"
  ],
  "additionalProperties": false
}
