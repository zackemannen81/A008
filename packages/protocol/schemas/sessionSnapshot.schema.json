{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "runtimePreferences": {
      "type": "object",
      "properties": {
        "revision": {
          "$ref": "#/$defs/__schema0"
        },
        "settings": {
          "$ref": "#/$defs/__schema1"
        },
        "defaults": {
          "$ref": "#/$defs/__schema1"
        },
        "fields": {
          "$ref": "#/$defs/__schema4"
        },
        "storagePath": {
          "$ref": "#/$defs/__schema6"
        }
      },
      "required": [
        "revision",
        "settings",
        "defaults",
        "fields",
        "storagePath"
      ]
    },
    "model": {
      "$ref": "#/$defs/__schema0"
    },
    "parameters": {
      "type": "object",
      "properties": {
        "stream": {
          "type": "boolean"
        },
        "temperature": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema2"
            },
            {
              "type": "null"
            }
          ]
        },
        "topP": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema2"
            },
            {
              "type": "null"
            }
          ]
        },
        "maxTokens": {
          "$ref": "#/$defs/__schema2"
        },
        "enableThinking": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reasoningBudget": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema2"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasoningEffort": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema0"
            },
            {
              "type": "null"
            }
          ]
        },
        "seed": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema2"
            },
            {
              "type": "null"
            }
          ]
        },
        "stop": {
          "anyOf": [
            {
              "readOnly": true,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            },
            {
              "type": "null"
            }
          ]
        }
