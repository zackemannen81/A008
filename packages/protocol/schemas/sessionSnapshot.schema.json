          "propertyNames": {
            "$ref": "#/$defs/__schema0"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema2"
          }
        },
        "semantic": {
          "type": "object",
          "properties": {
            "model": {
              "$ref": "#/$defs/__schema3"
            },
            "reasoningEffort": {
              "anyOf": [
                {
                  "$ref": "#/$defs/__schema0"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "model",
            "reasoningEffort"
          ]
        }
      },
      "required": [
        "instructions",
        "budgets"
      ]
    },
    "__schema2": {
      "type": "number"
    },
    "__schema3": {
      "minLength": 1,
      "$ref": "#/$defs/__schema0"
    },
    "__schema4": {
      "readOnly": true,
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema5"
      }
    },
    "__schema5": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/__schema0"
        },
        "label": {
          "$ref": "#/$defs/__schema0"
        },
        "unit": {
          "$ref": "#/$defs/__schema0"
        },
        "description": {
          "$ref": "#/$defs/__schema0"
        },
        "minimum": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "$ref": "#/$defs/__schema2"
        },
        "maximum": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "$ref": "#/$defs/__schema2"
        }
      },
      "required": [
        "key",
        "label",
        "unit",
        "description",
        "minimum",
        "maximum"
      ]
    },
    "__schema6": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema0"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema7": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "text"
            },
            "text": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "type",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "generated_image"
            },
            "generationId": {
              "$ref": "#/$defs/__schema3"
            },
            "prompt": {
              "$ref": "#/$defs/__schema3"
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "completed",
                "failed",
                "cancelled"
              ]
            },
            "locator": {
              "$ref": "#/$defs/__schema3"
            },
            "mediaType": {
              "$ref": "#/$defs/__schema3"
            },
            "filename": {
              "$ref": "#/$defs/__schema3"
            },
            "error": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "type",
            "generationId",
            "prompt",
            "status"
          ]
        }
      ]
    }
