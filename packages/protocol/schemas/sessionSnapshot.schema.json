    "runtime": {
      "type": "object",
      "properties": {
        "cwd": {
          "$ref": "#/$defs/__schema0"
        },
        "projectId": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema0"
            },
            {
              "type": "null"
            }
          ]
