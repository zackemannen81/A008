{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "expectedRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "parameters": {
      "type": "object",
      "properties": {
        "stream": {
          "type": "boolean"
        },
        "temperature": {
          "type": [
            "number",
            "null"
          ]
        },
        "topP": {
          "type": [
            "number",
            "null"
          ]
        },
        "maxTokens": {
          "type": "number"
        },
        "enableThinking": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reasoningBudget": {
          "type": [
            "number",
            "null"
          ]
        },
        "reasoningEffort": {
          "type": [
            "string",
            "null"
          ]
        },
        "seed": {
          "type": [
            "number",
            "null"
          ]
        },
        "stop": {
          "anyOf": [
            {
              "readOnly": true,
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "stream",
        "temperature",
        "topP",
        "maxTokens",
        "enableThinking",
        "reasoningBudget",
        "reasoningEffort",
        "seed",
        "stop"
      ]
    }
  },
  "required": [
    "expectedRevision",
    "model",
    "parameters"
  ],
  "additionalProperties": false
}
